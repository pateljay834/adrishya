From 415ce744f3c960cfd32823afebc99529933cbf2b Mon Sep 17 00:00:00 2001
From: Adrishya <dev@adrishya.local>
Date: Mon, 12 Oct 2026 08:52:38 +0000
Subject: [PATCH 1/6] hardening: kernel command-line (init_on_free, lockdown,
 vsyscall=none)

---
 auto/config | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/auto/config b/auto/config
index ebdf3b4..5ff910d 100755
--- a/auto/config
+++ b/auto/config
@@ -15,7 +15,9 @@ lb config \
   --debian-installer false \
   --apt-recommends false \
   --apt-indices false \
-  --bootappend-live "boot=live components quiet splash noeject nopersistence" \
+  --bootappend-live "boot=live components quiet splash noeject nopersistence \
+    slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 \
+    randomize_kstack_offset=on vsyscall=none debugfs=off oops=panic lockdown=confidentiality" \
   --linux-flavours amd64 \
   --memtest none \
   --compression xz \
-- 
2.39.5

