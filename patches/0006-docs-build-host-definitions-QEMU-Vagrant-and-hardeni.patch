+#!/usr/bin/env bash
+# Vagrant provisioner: install build dependencies in the guest.
+set -euo pipefail
+export DEBIAN_FRONTEND=noninteractive
+
+apt-get update
+apt-get install -y --no-install-recommends \
+    live-build git gnupg curl ca-certificates
+
+cd /adrishya
+./scripts/verify.sh
+echo "[+] build host ready. Run: sudo ./build.sh"
diff --git a/build-host/qemu-build.sh b/build-host/qemu-build.sh
new file mode 100755
index 0000000..a2d54bc
--- /dev/null
+++ b/build-host/qemu-build.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Build the Adrishya ISO inside a disposable Debian cloud VM using QEMU.
+# Requirements: qemu-system-x86_64, qemu-img, cloud-localds (or genisoimage).
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+REPO="$(cd "$HERE/.." && pwd)"
+CACHE="$HERE/.cache"
+OUT="$REPO/out"
+mkdir -p "$CACHE" "$OUT"
+
+IMG_URL="${IMG_URL:-https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2}"
+BASE="$CACHE/debian-13.qcow2"
+OVERLAY="$CACHE/overlay.qcow2"
+SEED="$CACHE/seed.iso"
+
+echo "[*] base image"
+if [ ! -f "$BASE" ]; then
+    curl -fL "$IMG_URL" -o "$BASE"
+fi
+
+echo "[*] overlay disk"
+rm -f "$OVERLAY"
+qemu-img create -f qcow2 -F qcow2 -b "$BASE" "$OVERLAY" >/dev/null
+
+echo "[*] cloud-init seed"
+if command -v cloud-localds >/dev/null 2>&1; then
+    cloud-localds "$SEED" "$HERE/cloud-init/user-data" "$HERE/cloud-init/meta-data"
+else
+    genisoimage -output "$SEED" -volid cidata -joliet -rock \
+        "$HERE/cloud-init/user-data" "$HERE/cloud-init/meta-data"
+fi
+
+ACCEL="tcg"
+if [ -w /dev/kvm ]; then ACCEL="kvm"; fi
+echo "[*] booting VM (accel=$ACCEL) - build output streams below"
+
+qemu-system-x86_64 \
+    -machine "accel=$ACCEL" -m 4096 -smp 4 \
+    -drive file="$OVERLAY",if=virtio,format=qcow2 \
+    -drive file="$SEED",if=virtio,format=raw \
+    -virtfs "local,path=$REPO,mount_tag=host0,security_model=none,readonly=off" \
+    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
+    -nographic -no-reboot
+
+echo "[+] VM finished. Look in $OUT for the ISO."
diff --git a/docs/HARDENING.md b/docs/HARDENING.md
new file mode 100644
index 0000000..ce514af
--- /dev/null
+++ b/docs/HARDENING.md
@@ -0,0 +1,45 @@
+# Adrishya hardening patch series
+
+These changes move Adrishya past "a live Debian with Tor" toward the hardening
+Tails applies. Each is a separate commit; run `git log --oneline` to see them and
+`ls patches/` for the exported `format-patch` files.
+
+## 1. Kernel command line
+Adds `slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1
+randomize_kstack_offset=on vsyscall=none debugfs=off oops=panic
+lockdown=confidentiality`. `init_on_free=1` zeroes freed memory, which also
+hardens the amnesia story. `lockdown=confidentiality` blocks kernel interfaces
+that could leak memory to userspace.
+
+## 2. systemd sandboxing drop-ins
+Tor and nftables run with `NoNewPrivileges`, `ProtectSystem=strict`,
+`ProtectHome`, `MemoryDenyWriteExecute`, a `SystemCallFilter`, and a minimal
+capability set. A compromised Tor or firewall process is contained.
+
+## 3. GNOME privacy lockdown
+Disables recent files, external search providers, location services, and
+thumbnailers, and locks the settings so an app cannot re-enable them. Fewer
+forensic traces and less metadata leakage.
+
+## 4. AppArmor profile for Tor Browser
+Ships in **complain** mode so you tune it from real logs before enforcing.
+Explicitly denies reads of `/etc/shadow`, `~/.ssh`, and `~/.gnupg`.
+
+## 5. Coredumps and extra sysctls
+Core dumps are disabled entirely (`Storage=none`), and `kernel.panic_on_oops`,
+`bpf_jit_harden=2`, and `dev.tty.ldisc_autoload=0` are set.
+
+## Applying / reverting
+
+The changes are already applied in this tree. To re-apply them elsewhere:
+
+```sh
+git am patches/*.patch
+```
+
+## Honest limits
+
+- Hardening is not the same as security. Without an audit and years of review,
+  none of this makes Adrishya as trustworthy as Tails.
+- The AppArmor profile is a starting point, not a finished one.
+- Test every change on hardware; several of these can break hardware support.
diff --git a/scripts/verify.sh b/scripts/verify.sh
index a9da659..490face 100755
--- a/scripts/verify.sh
+++ b/scripts/verify.sh
@@ -40,6 +40,12 @@ grep -q 'nopersistence' auto/config && ok "boot params disable persistence" || b
 grep -q 'TransPort 9040' config/hooks/live/0100-adrishya-tor-default.hook.chroot && ok "Tor transparent proxy configured" || bad "Tor TransPort missing"
 grep -q 'Storage=volatile' config/hooks/live/0100-adrishya-tor-default.hook.chroot && ok "journald volatile" || bad "journald not volatile"
 
+head_ "Hardening present"
+grep -q "init_on_free=1" auto/config && ok "kernel cmdline hardened" || bad "kernel cmdline hardening missing"
+grep -q "lockdown=confidentiality" auto/config && ok "kernel lockdown enabled" || bad "kernel lockdown missing"
+[ -f config/includes.chroot/etc/systemd/system/tor.service.d/10-adrishya-sandbox.conf ] && ok "tor sandbox drop-in" || bad "tor sandbox drop-in missing"
+[ -f config/includes.chroot/etc/dconf/db/local.d/00-adrishya-privacy ] && ok "GNOME privacy lockdown" || bad "privacy lockdown missing"
+
 head_ "Hook ordering"
 hooks=$(ls config/hooks/live/*.hook.chroot 2>/dev/null | wc -l)
 [ "$hooks" -ge 5 ] && ok "$hooks hooks present" || bad "expected at least 5 hooks, found $hooks"
